# Server Configuration
PORT=5000
NODE_ENV=development
API_URL=http://localhost:5000

# Database
MONGODB_URI=mongodb://localhost:27017/meeting-assistant
# Or for PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/meeting_assistant

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRE=7d

# LiteLLM Configuration
LITELLM_API_KEY=your_litellm_api_key
LITELLM_API_BASE=https://api.litellm.ai/v1
LLM_MODEL=gpt-3.5-turbo

# OpenAI (if using OpenAI via LiteLLM)
OPENAI_API_KEY=your_openai_api_key
OPENAI_ORG_ID=your_org_id

# Email Configuration
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=noreply@meetingassistant.com

# File Upload
MAX_FILE_SIZE=500000000
UPLOAD_DIR=./uploads
RECORDINGS_DIR=./recordings

# CORS
CORS_ORIGIN=http://localhost:3000

# AWS S3 (Optional - for cloud storage)
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_S3_BUCKET=meeting-assistant-bucket
AWS_REGION=us-east-1
